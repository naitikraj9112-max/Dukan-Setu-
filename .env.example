# Supabase project values. The backend uses this publishable/legacy anon key plus
# the user's JWT, preserving RLS. Never put a secret/service_role key in the app.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-publishable-or-anon-key

# Optional comma-separated exact browser origins. Empty disables browser CORS.
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=INFO
